---
// 1. Se importa el layout principal
import AdminLayout from '@/layouts/AdminLayout.astro';

// 2. Definición de tipos (Interfaces) para los datos del backend
interface Operador {
  id_empleado: number;
  nombre: string;
  rut_empleado: string;
  telefono: string;
  correo: string;
  direccion: string;
  fecha_de_ingreso: string;
  rol: string;
  usuario: string;
}

interface Proveedor {
  id_proveedor: number;
  id_empleado: number; // Quien lo registró
  nombre_empresa: string;
  correo: string;
  telefono: string;
  direccion: string;
}

// 3. Variables para almacenar los datos y el error
let primerosOperadores: Operador[] = [];
let primerosProveedores: Proveedor[] = [];
let errorMsg: string | null = null;

const API_URL = import.meta.env.PUBLIC_VITE_API_URL || 'http://127.0.0.1:8000';

try {
  // 4. Fetch a los Operadores (Empleados)
  const resOp = await fetch(`${API_URL}/empleados/`);
  if (!resOp.ok) throw new Error('Error al cargar operadores');
  const todosOperadores = await resOp.json() as Operador[];
  primerosOperadores = todosOperadores.slice(0, 3); // Tomamos solo los 3 primeros

  // 5. Fetch a los Proveedores
  const resProv = await fetch(`${API_URL}/proveedores/`);
  if (!resProv.ok) throw new Error('Error al cargar proveedores');
  const todosProveedores = await resProv.json() as Proveedor[];
  primerosProveedores = todosProveedores.slice(0, 3); // Tomamos solo los 3 primeros

} catch (error) {
  console.error(error);
  errorMsg = "No se pudo conectar con el backend. Asegúrese de que esté en ejecución.";
}
---

<AdminLayout title="Admin Dashboard | El Vecino">
   
  <div class="flex flex-col gap-10 items-center">
    <h1 class="text-5xl font-extrabold text-white drop-shadow-lg mb-4">
      Admin Dashboard
    </h1>

    {errorMsg && (
      <div class="w-full max-w-5xl p-4 bg-red-800/80 text-white text-center rounded-lg shadow-lg">
        <strong>Error:</strong> {errorMsg}
      </div>
    )}

    {/* SECCIÓN PROVEEDORES */}
    <section class="w-full max-w-5xl p-8 bg-white/30 backdrop-blur-md border border-white/40 rounded-2xl shadow-xl">
      <h2 class="text-2xl font-bold text-black mb-1">
        Proveedores Recientes
      </h2>
      <p class="text-gray-700 mb-6">Últimos registrados</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        {primerosProveedores.map(prov => (
          <div class="bg-white/80 rounded-xl p-4 flex flex-col items-center text-center shadow-md">
            
            {/* 👇 CAMBIO 1: Imagen fija para proveedores */}
            <img
              src="/proveedor.png"
              alt={prov.nombre_empresa}
              class="w-24 h-24 object-cover rounded-full mb-3 border-2 border-white"
            />

            <h3 class="font-semibold text-lg text-gray-900">{prov.nombre_empresa}</h3>
            <p class="text-gray-600 text-sm">
              {prov.correo} {/* Mostramos el correo como info */}
            </p>
          </div>
        ))}
        
        {primerosProveedores.length === 0 && !errorMsg && (
          <p class="text-gray-700 col-span-3 text-center">No hay proveedores para mostrar.</p>
        )}
      </div>
    </section>

    {/* SECCIÓN OPERADORES */}
    <section class="w-full max-w-5xl p-8 bg-white/30 backdrop-blur-md border border-white/40 rounded-2xl shadow-xl">
      <h2 class="text-2xl font-bold text-black mb-6">Operadores</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        {primerosOperadores.map(op => (
          <div class="bg-white/80 rounded-xl p-4 flex flex-col items-center text-center shadow-md">
            
            {/* 👇 CAMBIO 2: Condicional para admin vs user normal */}
            <img
              src={op.rol.toLowerCase() === 'administrador' ? '/admin.png' : '/default-user.png'}
              alt={op.nombre}
              class="w-24 h-24 object-cover rounded-full mb-3 border-2 border-white"
            />

            <h3 class="font-semibold text-lg text-gray-900">{op.nombre}</h3>
            <p class="text-gray-700 text-sm">Rol: {op.rol}</p>
            <p class="text-gray-500 text-xs">RUT: {op.rut_empleado}</p>
          </div>
        ))}

        {primerosOperadores.length === 0 && !errorMsg && (
          <p class="text-gray-700 col-span-3 text-center">No hay operadores para mostrar.</p>
        )}
      </div>
    </section>
  </div>
</AdminLayout>